{
  "name": "@novos-conceitos/unit-shell",
  "version": "1.0.1",
  "description": "Gerencia navbar e footer dinâmicos por unidade em projetos Webflow, com cache, reescrita de âncoras e fetch de componentes.",
  "main": "dist/nc-unit-shell.js",
  "unpkg": "dist/nc-unit-shell.min.js",
  "jsdelivr": "dist/nc-unit-shell.min.js",
  "keywords": [
    "webflow",
    "navbar",
    "footer",
    "unit",
    "shell",
    "dynamic",
    "cache"
  ],
  "author": "Novos Conceitos <lucas@novosconceitos.com.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Novos-Conceitos/unit-shell.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/Novos-Conceitos/unit-shell/issues"
  },
  "homepage": "https://github.com/Novos-Conceitos/unit-shell#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/nc-unit-shell.js --bundle=false --minify --outfile=dist/nc-unit-shell.min.js && node -e \"require('fs').copyFileSync('src/nc-unit-shell.js','dist/nc-unit-shell.js')\"",
    "dev": "esbuild src/nc-unit-shell.js --watch --outfile=dist/nc-unit-shell.min.js",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && npm publish --access public",
    "release:minor": "npm version minor && npm publish --access public",
    "release:major": "npm version major && npm publish --access public"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
